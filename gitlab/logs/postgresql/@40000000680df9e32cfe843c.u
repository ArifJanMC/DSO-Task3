2025-04-27_09:18:57.72631 LOG:  duration: 1083.853 ms  statement: with table_opts_vs_statistic as (
2025-04-27_09:18:57.72653 	  select
2025-04-27_09:18:57.72653 	    pg_class.oid,
2025-04-27_09:18:57.72653 	    pg_class.relname,
2025-04-27_09:18:57.72654 	    coalesce(nspname, 'public') as schemaname,
2025-04-27_09:18:57.72654 	    pg_class.relpages,
2025-04-27_09:18:57.72654 	    pg_class.reltuples,
2025-04-27_09:18:57.72654 	    case
2025-04-27_09:18:57.72655 	      when array_to_string(reloptions, '') like '%autovacuum_vacuum_threshold%' then regexp_replace(array_to_string(reloptions, ''), '.*autovacuum_vacuum_threshold=([0-9.]+).*', E'\\1')::int8
2025-04-27_09:18:57.72655 	      else current_setting('autovacuum_vacuum_threshold')::int8
2025-04-27_09:18:57.72655 	    end as autovacuum_vacuum_threshold,
2025-04-27_09:18:57.72655 	    case
2025-04-27_09:18:57.72655 	      when array_to_string(reloptions, '') like '%autovacuum_vacuum_scale_factor%' then regexp_replace(array_to_string(reloptions, ''), '.*autovacuum_vacuum_scale_factor=([0-9.]+).*', E'\\1')::numeric
2025-04-27_09:18:57.72656 	      else current_setting('autovacuum_vacuum_scale_factor')::numeric
2025-04-27_09:18:57.72657 	    end as autovacuum_vacuum_scale_factor,
2025-04-27_09:18:57.72657 	    case when array_to_string(reloptions, '') ~ 'autovacuum_enabled=(false|off)' then false else true end as autovacuum_enabled,
2025-04-27_09:18:57.72657 	    n_dead_tup,
2025-04-27_09:18:57.72658 	    last_autovacuum,
2025-04-27_09:18:57.72659 	    last_vacuum
2025-04-27_09:18:57.72660 	  from pg_class
2025-04-27_09:18:57.72660 	  join pg_namespace ns on relnamespace = ns.oid 
2025-04-27_09:18:57.72660 	  join pg_stat_all_tables psat  on psat.relid  = pg_class.oid
2025-04-27_09:18:57.72660 	  where relkind in ('r','m') 
2025-04-27_09:18:57.72661 	), p as (
2025-04-27_09:18:57.72661 	  select pgspv.*,a.query,a.wait_event_type,a.wait_event,a.query_start
2025-04-27_09:18:57.72661 	  from pg_stat_progress_vacuum pgspv
2025-04-27_09:18:57.72661 	  left join pg_stat_activity a using (pid)
2025-04-27_09:18:57.72661 	) 
2025-04-27_09:18:57.72662 	select
2025-04-27_09:18:57.72662 	  table_opts_vs_statistic.schemaname as schemaname,
2025-04-27_09:18:57.72662 	  table_opts_vs_statistic.relname as relname,
2025-04-27_09:18:57.72662 	  round((100 * table_opts_vs_statistic.n_dead_tup::numeric / nullif(table_opts_vs_statistic.reltuples, 0))::numeric, 2) as dead_tup_pct,
2025-04-27_09:18:57.72663 	  table_opts_vs_statistic.reltuples::numeric as reltuples,
2025-04-27_09:18:57.72663 	  table_opts_vs_statistic.n_dead_tup,
2025-04-27_09:18:57.72663 	  (relpages::bigint*8*1024) AS table_size_bytes,
2025-04-27_09:18:57.72663 	  'V. Threshold:' || table_opts_vs_statistic.autovacuum_vacuum_threshold
2025-04-27_09:18:57.72663 	    || ', V. Scale Factor: ' || (table_opts_vs_statistic.autovacuum_vacuum_scale_factor)::numeric *100 ||' %'
2025-04-27_09:18:57.72665 	    || case when not autovacuum_enabled then ', DISABLED' else ', enabled' end as "effective_settings",
2025-04-27_09:18:57.72666 	  case
2025-04-27_09:18:57.72666 	    when last_autovacuum > coalesce(last_vacuum, '0001-01-01') then last_autovacuum::timestamp(0)
2025-04-27_09:18:57.72666 	    when last_vacuum is not null then last_vacuum::timestamp(0)
2025-04-27_09:18:57.72666 	    else null
2025-04-27_09:18:57.72666 	  end as "last_vacuumed",
2025-04-27_09:18:57.72667 	  case
2025-04-27_09:18:57.72667 	    when last_autovacuum > coalesce(last_vacuum, '0001-01-01') then 'auto'
2025-04-27_09:18:57.72667 	    when last_vacuum is not null then 'manual'
2025-04-27_09:18:57.72667 	    else null
2025-04-27_09:18:57.72668 	  end as "type",
2025-04-27_09:18:57.72668 	  coalesce(p.phase, 'in queue') as status,
2025-04-27_09:18:57.72668 	  p.pid as pid,
2025-04-27_09:18:57.72668 	  coalesce  (p.query,'')as  action,
2025-04-27_09:18:57.72668 	  case when p.pid is null then null else coalesce(wait_event_type ||'.'|| wait_event, 'f') end as waiting,
2025-04-27_09:18:57.72669 	  round(100.0 * p.heap_blks_scanned / nullif(p.heap_blks_total, 0), 1) AS scanned_pct,
2025-04-27_09:18:57.72669 	  round(100.0 * p.heap_blks_vacuumed / nullif(p.heap_blks_total, 0), 1) AS vacuumed_pct,
2025-04-27_09:18:57.72669 	  extract ('epoch' from  now()-query_start) elapsed_time
2025-04-27_09:18:57.72669 	from 
2025-04-27_09:18:57.72670 	table_opts_vs_statistic
2025-04-27_09:18:57.72670 	full outer join p on p.relid = table_opts_vs_statistic.oid and p.datname = current_database()
2025-04-27_09:18:57.72670 	where
2025-04-27_09:18:57.72670 	  table_opts_vs_statistic.relpages >= 8
2025-04-27_09:18:57.72670 	  and  autovacuum_vacuum_threshold + (autovacuum_vacuum_scale_factor::numeric * table_opts_vs_statistic.reltuples) < table_opts_vs_statistic.n_dead_tup
